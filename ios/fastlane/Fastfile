default_platform(:ios)

platform :ios do

  desc "Set AppStore Connect API KEY using the provided environment variables."
  lane :apikey do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_API_KEY_PATH"],
      duration: 1200, # optional (maximum 1200)
      in_house: false # optional but may be required if using match/sigh
    )
  end

  ###############################################################################

  desc "Push a new release build to AppStore Connect for manual submission to TestFlight beta testing or App Store Release."
  lane :release do
    apikey
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner")
    upload_to_app_store(
      precheck_include_in_app_purchases: false
    )
  end

  ###############################################################################

  ###############################################################################
  # The lanes below are used by the publish-qa / publish-production workflows
  # (docs/ci-publishing.md) to publish a customized build. They never touch the
  # store listing: the metadata and screenshots in this folder describe upstream
  # wger.
  #
  # Configuration comes from the environment:
  #   APP_ID_IOS, APP_NAME            identity of the custom app
  #   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   App Store Connect API key
  #   IPA_PATH                        the .ipa to upload
  ###############################################################################

  desc "Point the committed project at the custom identity and manual signing. Changes the working copy only, CI never commits it."
  lane :customize do |options|
    app_id = options[:app_id].to_s.strip
    app_name = options[:app_name].to_s.strip
    UI.user_error!("app_id is required") if app_id.empty?
    UI.user_error!("app_name is required") if app_name.empty?

    update_app_identifier(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      app_identifier: app_id
    )
    update_info_plist(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      display_name: app_name
    )
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: options[:team_id],
      code_sign_identity: options[:code_sign_identity],
      profile_name: options[:profile_name],
      bundle_identifier: app_id
    )
  end

  def custom_asc_api_key
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64].each do |name|
      UI.user_error!("#{name} is not set") if ENV[name].to_s.strip.empty?
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"].strip,
      issuer_id: ENV["ASC_ISSUER_ID"].strip,
      key_content: ENV["ASC_KEY_P8_BASE64"].strip,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end

  def custom_ipa
    path = ENV["IPA_PATH"].to_s.strip
    UI.user_error!("IPA_PATH is not set") if path.empty?
    UI.user_error!("No ipa at #{path}") unless File.exist?(path)
    path
  end

  desc "Upload the custom build to TestFlight (QA) without waiting for Apple to process it"
  lane :qa do
    upload_to_testflight(
      api_key: custom_asc_api_key,
      ipa: custom_ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload the custom build to App Store Connect (production). Pass submit_for_review:true to also submit it."
  lane :production_custom do |options|
    submit = options[:submit_for_review].to_s.strip.downcase == "true"
    upload_to_app_store(
      api_key: custom_asc_api_key,
      ipa: custom_ipa,
      skip_metadata: true,
      skip_screenshots: true,
      force: true, # no interactive confirmation of the HTML preview on CI
      submit_for_review: submit,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Test if all environment variables are present and check if API key is working properly."
  lane :test_env do
    UI.message "🔍 Testing environment variables..."

    UI.message "APP_STORE_API_KEY_ID: #{ENV['APP_STORE_API_KEY_ID']}"
    UI.message "APP_STORE_API_ISSUER_ID: #{ENV['APP_STORE_API_ISSUER_ID']}"
    UI.message "APP_STORE_API_KEY_PATH: #{ENV['APP_STORE_API_KEY_PATH']}"
    UI.message "APPLE_ID: #{ENV['APPLE_ID']}"
    UI.message "ITC_TEAM_ID: #{ENV['ITC_TEAM_ID']}"
    UI.message "TEAM_ID: #{ENV['TEAM_ID']}"

    UI.success "✅ Environment variables loaded."

    UI.message "🔐 Testing App Store Connect API key authentication..."

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_API_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    # Test: Fetch list of apps to verify authentication
    apps = Spaceship::ConnectAPI::App.all
    UI.success "✅ API Key is valid! Found #{apps.count} apps in your App Store Connect account."

  rescue => ex
    UI.error "❌ API Key authentication failed: #{ex.message}"
    UI.user_error!("Please check your API key environment variables and credentials.")
  end

end
