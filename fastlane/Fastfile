# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)


lane :playstore do
  gradle(
    task: 'assemble',
    build_type: 'Release'
  )
end

# The helpers and the internal / production_custom lanes below are used by the
# publish-qa / publish-production workflows (docs/ci-publishing.md). They publish a customized build, so unlike the
# upstream lanes above they never touch the store listing: the metadata,
# images and screenshots in fastlane/metadata/android describe upstream wger.
#
# Configuration comes from the environment:
#   PLAY_JSON_KEY_FILE   path to the Google Play service account json (required)
#   AAB_PATH             the bundle to upload (default: flutter's release output)
#   APP_ID_ANDROID       application id, see Appfile
#   PLAY_RELEASE_STATUS  completed or draft

def custom_build_aab
  path = ENV["AAB_PATH"].to_s.strip
  path = "./build/app/outputs/bundle/release/app-release.aab" if path.empty?
  UI.user_error!("No app bundle at #{path}") unless File.exist?(path)
  path
end

def custom_play_json_key
  path = ENV["PLAY_JSON_KEY_FILE"].to_s.strip
  UI.user_error!("PLAY_JSON_KEY_FILE must point to the Google Play service account json") if path.empty?
  UI.user_error!("No service account json at #{path}") unless File.exist?(path)
  path
end

def custom_upload_to_play(track:, release_status:)
  unless %w[completed draft].include?(release_status)
    UI.user_error!("release_status must be 'completed' or 'draft', got '#{release_status}'")
  end
  upload_to_play_store(
    json_key: custom_play_json_key,
    track: track,
    aab: custom_build_aab,
    release_status: release_status,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_changelogs: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
  )
end

platform :android do

  desc "Check playstore configuration, does not upload any files"
  lane :test_configuration do
    begin
      upload_to_play_store(
        json_key: 'fastlane/metadata/envfiles/playstore.json',
        track: 'production',
        validate_only: true,
        aab: './build/app/outputs/bundle/release/app-release.aab',
      )
    end
  end


  desc "Upload app to production"
  lane :production do
    begin
      upload_to_play_store(
        json_key: 'fastlane/metadata/envfiles/playstore.json',
        track: 'production',
        aab: './build/app/outputs/bundle/release/app-release.aab',
        skip_upload_metadata: false,
        skip_upload_images: false,
        skip_upload_screenshots: false,
        release_status: "completed", #"draft",
      )
    end
  end


  desc "Upload the custom build to the internal testing track (QA)"
  lane :internal do
    status = ENV["PLAY_RELEASE_STATUS"].to_s.strip
    custom_upload_to_play(track: "internal", release_status: status.empty? ? "completed" : status)
  end

  desc "Upload the custom build to the production track, as a draft unless PLAY_RELEASE_STATUS=completed"
  lane :production_custom do
    status = ENV["PLAY_RELEASE_STATUS"].to_s.strip
    custom_upload_to_play(track: "production", release_status: status.empty? ? "draft" : status)
  end


  desc "Upload closed alpha app and update store entry"
  lane :update_alpha do
    begin
      upload_to_play_store(
        json_key: 'fastlane/metadata/envfiles/playstore.json',
        track: 'alpha',
        aab: './build/app/outputs/bundle/release/app-release.aab',
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        release_status: "completed", #"draft",
      )
    end
  end

end
